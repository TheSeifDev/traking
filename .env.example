# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sovereign TrackUp Authentication & Sessions
TRACKUP_OWNER_EMAIL=owner@trackup.dev
# 32+ bytes base64url or hex secret for HMAC session signing
TRACKUP_SESSION_SECRET=your-32-byte-base64url-session-secret

# Email Delivery (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications@trackup.dev
RESEND_REPLY_TO=support@trackup.dev

# Platform Health & Scheduler Cron Secret
CRON_SECRET=your-random-cron-secret
